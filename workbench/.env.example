APP_NAME="AutoHeal SDK sample"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

CACHE_STORE=file
QUEUE_CONNECTION=sync

# The platform API, and an SDK key created on an environment's page in the AutoHeal dashboard.
AUTOHEAL_ENDPOINT=http://localhost:8100/api/v1
AUTOHEAL_KEY=
AUTOHEAL_RELEASE=sample-dev
AUTOHEAL_SERVICE=sdk-sample
