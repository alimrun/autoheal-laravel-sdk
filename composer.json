{
    "name": "autoheal/laravel-sdk",
    "description": "Reports exceptions, error logs, deployments, heartbeats and health checks from a Laravel application to AutoHeal.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "autoheal", "monitoring", "error-tracking"],
    "homepage": "https://github.com/alimrun/autoheal-laravel-sdk",
    "support": {
        "issues": "https://github.com/alimrun/autoheal-laravel-sdk/issues",
        "source": "https://github.com/alimrun/autoheal-laravel-sdk"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "AutoHeal\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AutoHeal\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AutoHeal\\Laravel\\AutoHealServiceProvider"
            ],
            "aliases": {
                "AutoHeal": "AutoHeal\\Laravel\\Facades\\AutoHeal"
            }
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@clear",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "./vendor/bin/pest",
        "check": [
            "./vendor/bin/pint --test",
            "./vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
            "./vendor/bin/pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
